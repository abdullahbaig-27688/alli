{
  "name": "livekit-react-native",
  "version": "2.9.6",
  "summary": "LiveKit for React Native",
  "homepage": "https://github.com/livekit/client-sdk-react-native#readme",
  "license": "Apache-2.0",
  "authors": "LiveKit <dl@livekit.io> (https://livekit.io/)",
  "platforms": {
    "ios": "10.0"
  },
  "source": {
    "git": "https://github.com/livekit/client-sdk-react-native.git",
    "tag": "2.9.6"
  },
  "source_files": "ios/**/*.{h,m,mm,swift}",
  "public_header_files": "ios/Headers/*.h",
  "frameworks": "AVFAudio",
  "pod_target_xcconfig": {
    "DEFINES_MODULE": "YES",
    "HEADER_SEARCH_PATHS": "\"$(PODS_ROOT)/Headers/Private/Yoga\"",
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED=1 ",
    "OTHER_SWIFT_FLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED"
  },
  "dependencies": {
    "livekit-react-native-webrtc": [],
    "React-Core": [],
    "React-RCTFabric": [],
    "ReactCodegen": [],
    "RCTRequired": [],
    "RCTTypeSafety": [],
    "ReactCommon/turbomodule/bridging": [],
    "ReactCommon/turbomodule/core": [],
    "React-NativeModulesApple": [],
    "Yoga": [],
    "React-Fabric": [],
    "React-graphics": [],
    "React-utils": [],
    "React-featureflags": [],
    "React-debug": [],
    "React-ImageManager": [],
    "React-rendererdebug": [],
    "React-jsi": [],
    "React-renderercss": [],
    "hermes-engine": [],
    "ReactNativeDependencies": [],
    "React-Core-prebuilt": []
  },
  "compiler_flags": "-DRCT_NEW_ARCH_ENABLED=1"
}
